---
import Layout from '../layouts/Layout.astro';
import PostCard from '../components/PostCard.astro';
import { sortPostsByDate, createEssayData } from '../utils/helpers';
import { getCollection } from 'astro:content';

const essays = await getCollection('blog'); // 'essay' used for specificity (vs. 'posts')
const sortedEssays = sortPostsByDate(essays);
const essayData = sortedEssays.map(createEssayData);
---

<Layout>
	<section class="header-section">
		<h1 class="site-title">Blog</h1>
	</section>
	<div class="blog-grid">
		{essayData.map(essay => <PostCard {...essay} />)}
	</div>
</Layout>

<style>
	.header-section {
		text-align: center;
		color: var(--color-text-secondary);
	}
	.site-title {
		font-size: var(--font-size-h2);
	}
	.blog-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: var(--space-sm);
	}
</style>
