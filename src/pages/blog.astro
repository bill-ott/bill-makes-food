---
import Layout from '../layouts/Layout.astro';
import PostCard from '../components/PostCard.astro';
import { formatRawDate, formatDate } from '../utils/helpers';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog');

const sortedPreviewPosts = [...posts] // only first 3 will show
	.sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())

const postData = sortedPreviewPosts.map((post) => ({
	href: `/blog/${post.id}`,
	title: post.data.title,
	dateRaw: formatRawDate(post.data.publishDate),
	publishDate: formatDate(post.data.publishDate),
	summary: post.data.summary,
}));

---

<Layout>
	<section class="header-section">
		<h1 class="site-title">Blog</h1>
	</section>
	<div class="blog-grid">
		{postData.map(post => <PostCard {...post} />)}
	</div>
</Layout>

<style>
	.header-section {
		text-align: center;
		color: var(--color-text-secondary);
	}
	.site-title {
		font-size: var(--font-size-h2);
	}
	.blog-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: var(--space-sm);
	}
</style>
