---
import Layout from '../../layouts/Layout.astro';
import { Image } from 'astro:assets';
import { getCollection, render } from 'astro:content';
import { formatDate, formatRawDate } from '../../utils/helpers';

export async function getStaticPaths() {
	const recipes = await getCollection('recipes');
	return recipes.map((recipe) => ({
		params: { id: recipe.id },
		props: { recipe },
	}));
}

const { recipe } = Astro.props;
const { Content } = await render(recipe);
---

<Layout>
	<article class="post-content">
		<h1 class="post-title-header">{recipe.data.title}</h1>
        <div class="base-data-wrapper">
            <time
                class="post-publish-date"
                datetime={formatRawDate(recipe.data.publishDate)}>
                {formatDate(recipe.data.publishDate)}
            </time>
            <span class="base-data-divider">•</span>
            <span class="cook-time">{recipe.data.cookTime} mins</span>
            <span class="base-data-divider">•</span>
            <span class="serving">Serves {recipe.data.servings}</span>
        </div>
        <div class="secondary-data-wrapper">
            <div class="ingredient-list-wrapper">
                <h2 class="ingredient-header">
                    Ingredients
                </h2>
                <ul class="ingredients-list">
                    {
                        recipe.data.ingredients.map((ingredient) => (
                            <li class="ingredient">
                                <span class="ingredient-name">{ingredient.item}</span>
                                {ingredient.amount != null && <span class="ingredient-amount"> {ingredient.amount}</span>}
                                {ingredient.unit && <span class="ingredient-unit">{ingredient.unit}</span>}
                            </li>
                        ))
                    }
                </ul>
            </div>
            <Image
                src={recipe.data.heroImage}
                alt={recipe.data.title}
                loading="eager"
                class="card-image" />
        </div>
        <div class="content-section">
            <Content />
        </div>
	</article>
</Layout>

<style>
    .post-content {
        display: flex;
        flex-direction: column;
        padding: var(--space-md);
    }
    .post-title-header {
        font-size: var(--font-size-h4);
        margin: 0;
    }
    .base-data-wrapper {
        color: var(--color-text-tertiary);
        font-size: var(--font-size-md);
        margin: var(--space-sm) 0 var(--space-xs);
        display: flex;
    }
    .base-data-divider {
        padding: 0 var(--space-xs);
    }
    .secondary-data-wrapper {
        margin-top: var(--space-sm);
        display: flex;
        gap: var(--space-xl);
    }
    .ingredient-header {
        margin: 0;
        font-size: var(--font-size-h6);
    }
    .card-image {
        width:  25rem;
        height: 25rem;
        display: block;
        transition: transform 0.2s ease;
    }
    .content-section {
        margin-top: var(--space-md);
    }
</style>