---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import { formatDate, formatRawDate } from '../../utils/helpers';

export async function getStaticPaths() {
	const recipes = await getCollection('recipes');
	return recipes.map((recipe) => ({
		params: { id: recipe.id },
		props: { recipe },
	}));
}

const { recipe } = Astro.props;
const { Content } = await render(recipe);
---

<Layout>
	<article class="post-content">
		<h1 class="post-title-header">{recipe.data.title}</h1>
		<time
            class="post-publish-date"
            datetime={formatRawDate(recipe.data.publishDate)}>
			{formatDate(recipe.data.publishDate)}
		</time>
		<Content />
	</article>
</Layout>

<style>
    .post-content {
        display: flex;
        flex-direction: column;
        padding: var(--space-md);
    }
    .post-title-header {
        font-size: var(--font-size-h4);
    }
    .post-publish-date {
        display: inline-block;
        color: var(--color-text-tertiary);
        font-size: var(--font-size-md);
        margin: var(--space-xs) 0;
    }
    :global(.post-content img) {
        display: block;
        margin-inline: auto;
        max-width: 100%;
        height: auto;
    }
</style>