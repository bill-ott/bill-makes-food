---
import Layout from '../../layouts/Layout.astro';
import EssayCard from '../../components/EssayCard.astro';
import PageNav from '../../components/PageNav.astro';
import type { GetStaticPathsOptions } from 'astro';
import { sortPostsByDate, createEssayData } from '../../utils/helpers';
import { getCollection } from 'astro:content';

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
	const essays = await getCollection('blog');
	const sortedEssays = sortPostsByDate(essays);
	return paginate(sortedEssays, { pageSize: 10 });
}

const { page } = Astro.props;
const essayData = page.data.map(createEssayData);
---

<Layout>
	<section class="header-section">
		<h1 class="site-title">Blog</h1>
	</section>
	<div class="blog-grid">
		{essayData.map(essay => <EssayCard {...essay} />)}
	</div>
	<PageNav page={page}/>
</Layout>

<style>
	.header-section {
		text-align: center;
		color: var(--color-text-secondary);
	}
	.site-title {
		font-size: var(--font-size-h2);
	}
	.blog-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: var(--space-sm);
	}
</style>
