---
import Layout from '../../layouts/Layout.astro';
import { getCollection, getEntries, render } from 'astro:content';
import { formatDate, formatRawDate } from '../../utils/helpers';

export async function getStaticPaths() {
	const essays = await getCollection('blog');
	return essays.map((essay) => ({
		params: { id: essay.id },
		props: { essay },
	}));
}

const { essay } = Astro.props;
const { Content } = await render(essay);
const relatedRecipes = (await getEntries(essay.data.relatedRecipes ?? [])).filter((recipe) => recipe !== undefined);
---

<Layout>
	<article class="post-content">
		<h1 class="post-title-header">{essay.data.title}</h1>
		<time
            class="post-publish-date"
            datetime={formatRawDate(essay.data.publishDate)}>
			{formatDate(essay.data.publishDate)}
		</time>
		<Content />
        {
            relatedRecipes.length > 0 &&
                <div class="related-recipes">
                    Related recipes: {relatedRecipes.map((recipe, i) => (
                        <>
                            <a class="related-recipe-link" href={`/recipes/${recipe.id}`}>{recipe.data.title}</a>
                            {i < relatedRecipes.length - 1 && ', '}
                        </>
                    ))}
                </div>
        }
	</article>
</Layout>

<style>
    .post-content {
        display: flex;
        flex-direction: column;
        padding: var(--space-md);
    }
    .post-title-header {
        font-size: var(--font-size-h4);
    }
    .post-publish-date {
        display: inline-block;
        color: var(--color-text-tertiary);
        font-size: var(--font-size-md);
        margin: var(--space-xs) 0;
    }
    :global(.post-content img) {
        display: block;
        margin-inline: auto;
        max-width: 100%;
        height: auto;
    }
    .related-recipes {
        margin-top: var(--space-sm);
        font-weight: 500;
    }
    .related-recipe-link {
        text-decoration: none;
        color: var(--color-link);
    }
</style>