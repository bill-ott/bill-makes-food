---
import Layout from '../layouts/Layout.astro';
import PostCard from '../components/PostCard.astro';
import RecipeCard from '../components/RecipeCard.astro';
import { getCollection } from 'astro:content';

function formatRawDate(date: Date) {
	return date.toISOString().split('T')[0];
}

function formatDate(date: Date) {
	return date.toLocaleDateString('en-US', {
		month: 'long',
		day: 'numeric',
		year: 'numeric',
		timeZone: 'UTC',
	});
}

const posts = await getCollection('blog');
const postData = posts.map(post => {
	return {
		href: `/blog/${post.id}`,
		title: post.data.title,
		dateRaw: formatRawDate(post.data.publishDate),
		publishDate: formatDate(post.data.publishDate),
		previewText: post.data.previewText,
	};
});

const recipes = await getCollection('recipes');
const recipeData = recipes.map(recipe => {
	return {
		href: `/recipes/${recipe.id}`,
		title: recipe.data.title,
		dateRaw: formatRawDate(recipe.data.publishDate),
		publishDate: formatDate(recipe.data.publishDate),
		cookTime: recipe.data.cookTime,
		summary: recipe.data.summary,
		tags: recipe.data.tags,
		heroImage: recipe.data.heroImage,
	};
});
---

<Layout>
	<section class="header-section">
		<h1 class="site-title">Bill Makes Food</h1>
		<p class="tagline">Joy in habitual home cooking</p>
		<p class="intro">
			I've gradually developed a lifestyle I call "cooking by default".
			This is where I share what I've learned.
			Maybe you'll find it helpful, even if you don't (yet) love to cook.
		</p>
	</section>
	<div class="home-page-content-wrapper">
		<section class="blog-section">
			<h2 class="content-header">LATEST POSTS</h2>
			<div class="blog-grid">
				{postData.map(post => <PostCard {...post} />)}
			</div>
		</section>
		<section class="recipe-section">
			<h2 class="content-header">FEATURED RECIPES</h2>
			<div class="recipe-grid">
				{recipeData.map(recipe => <RecipeCard {...recipe} />)}
			</div>
		</section>
	</div>
</Layout>

<style>
	.header-section {
		color: var(--color-text-primary);
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		margin-top: var(--space-md);
	}
	.site-title {
		font-size: var(--font-size-h2);
		font-weight: 500;
		color: var(--color-text-secondary);
		margin: 0;
	}
	.tagline {
		color: var(--color-text-tertiary);
		font-size: var(--font-size-h5);
		margin: 0; /* resets default */
		margin-top: var(--space-sm);
	}
	.intro {
		margin-top: var(--space-lg);
		max-width: 70ch;
	}
	.home-page-content-wrapper {
		margin-top: var(--space-xl);
	}
	.content-header {
		border-top: var(--section-border);
		font-size: var(--font-size-p);
		padding-top: var(--space-sm);
		color: var(--color-text-tertiary);
	}
	.recipe-section {
		margin-top: var(--space-md);
	}
	.blog-grid, .recipe-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
		gap: var(--space-sm);
	}
</style>
