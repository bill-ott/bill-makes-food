---
import Layout from '../layouts/Layout.astro';
import PostCard from '../components/PostCard.astro';
import RecipeCard from '../components/RecipeCard.astro';
import { sortPostsByDate, createEssayData, createRecipeData } from '../utils/helpers';
import { getCollection } from 'astro:content';

const essays = await getCollection('blog'); // 'essay' used for specificity (vs. 'posts')
const sortedEssays = sortPostsByDate(essays, 3); // only first 3 will show
const essayData = sortedEssays.map(createEssayData);

const recipes = await getCollection('recipes');
const sortedRecipes = sortPostsByDate(recipes, 4); // only first 4 will show
const recipeData = sortedRecipes.map((recipe, i) => ({
	...createRecipeData(recipe),
	loading: i < 2 ? ('eager' as const) : ('lazy' as const),
}));
---

<Layout>
	<section class="header-section">
		<h1 class="site-title">Bill Makes Food</h1>
		<p class="tagline">Joy in habitual home cooking</p>
		<p class="intro">
			I've gradually developed a lifestyle I call "cooking by default".
			This is where I share what I've learned.
			Maybe you'll find it helpful, even if you don't (yet) love to cook.
		</p>
	</section>
	<div class="home-page-content-wrapper">
		<section class="blog-section">
			<h2 class="content-header">Latest blog posts</h2>
			<div class="blog-grid">
				{essayData.map(essay => <PostCard {...essay} />)}
			</div>
			<a
				class="see-all-link"
				href="/blog"
			>
				See all blog posts	
			</a>
		</section>
		<section class="recipe-section">
			<h2 class="content-header">Latest recipes</h2>
			<div class="recipe-grid">
				{recipeData.map(recipe => <RecipeCard {...recipe} />)}
			</div>
			<a
				class="see-all-link"
				href="/recipes"
			>
				See all recipes	
			</a>
		</section>
	</div>
</Layout>

<style>
	.header-section {
		color: var(--color-text-primary);
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		margin-top: var(--space-md);
	}
	.site-title {
		font-size: var(--font-size-h2);
		font-weight: 500;
		color: var(--color-text-secondary);
		margin: 0;
	}
	.tagline {
		color: var(--color-text-tertiary);
		font-size: var(--font-size-h5);
		margin: var(--space-sm) 0 0;
	}
	.intro {
		margin-top: var(--space-lg);
		max-width: 70ch;
	}
	.home-page-content-wrapper {
		margin-top: var(--space-xl);
	}
	.content-header {
		border-top: var(--section-border);
		font-size: var(--font-size-p);
		padding-top: var(--space-sm);
		color: var(--color-text-tertiary);
		text-transform: uppercase;
	}
	.recipe-section {
		margin-top: var(--space-md);
	}
	.blog-section, .recipe-section {
		display: flex;
		flex-direction: column;
	}
	.blog-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: var(--space-sm);
	}
	.see-all-link {
		margin: var(--space-sm) auto 0;
		text-decoration: none;
		color: var(--color-link);
	}
	.see-all-link:hover {
		color: color-mix(in srgb, var(--color-link) 65%, transparent);
	}
	.recipe-grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: var(--space-sm);
	}
	@media (max-width: 40rem) {
		.recipe-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
