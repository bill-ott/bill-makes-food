---
import type { Page } from 'astro';

interface Props {
  page: Page;
}

const { page } = Astro.props;
---
<nav
    class="page-nav"
    aria-label="Pagination">
    {page.url.prev &&
        <a
            class="page-hopper"
            href={page.url.prev}>
            ← Prev
        </a>
    }
    <span class="page-indicator">Page {page.currentPage} of {page.lastPage}</span>
    {page.url.next &&
        <a
            class="page-hopper"
            href={page.url.next}>
            Next →
        </a>
    }
</nav>


<style>
.page-nav {
    display: flex;
    justify-content: center;
    margin-top: var(--space-md);
    flex-wrap: wrap;
}
.page-hopper {
    color: var(--color-link);
    margin: 0 var(--space-xs);
    text-decoration: none;
}
.page-hopper:hover {
    color: color-mix(in srgb, var(--color-link) 65%, transparent);
}
</style>