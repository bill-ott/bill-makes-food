---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

type Props = {
    href: string;
    title: string;
    dateRaw: string;
    publishDate: string;
    summary: string;
    heroImage?: ImageMetadata;
    loading?: 'lazy' | 'eager';
};

const { href, title, dateRaw, publishDate, summary, heroImage,loading = 'lazy' } = Astro.props;

---
<article class="card-preview">
    <header class="post-title-header">
        <h3 class="post-title">
            <a class="title-link" href={href}>{title}</a>
        </h3>
        <div class="date-wrapper">
            <time class="post-publish-date" datetime={dateRaw}>
                {publishDate}
            </time>
        </div>
    </header>
    <div class="card-image-wrapper">
        {heroImage && (
            <Image
                src={heroImage}
                alt={title}
                loading={loading}
                class="card-image" />
        )}
    </div>
    <p class="post-preview-text">{summary}</p>
    <p class="full-post-text">Read more →</p>
</article>

<style>
	.card-preview {
        display: flex;
        flex-direction: column;
        position: relative;
        padding: var(--space-sm);
        border-radius: var(--radius-base);
        transition: background-color 0.2s ease;
	}
    .card-preview:hover {
        background-color: var(--color-surface-hover);
    }
    .card-preview:hover .card-image {
        transform: scale(1.03);
    }
    .post-title {
        font-size: var(--font-size-h5);
        margin: 0;
    }
    .title-link {
        color: var(--color-text-primary);
        text-decoration: none;
    }
    .title-link::after {
        content: "";
        position: absolute;
        inset: 0;
    }
    .date-wrapper {
        color: var(--color-text-tertiary);
        font-size: var(--font-size-sm);
        margin-top: var(--space-xs);
        display: flex;
    }
    .date-divider {
        margin: 0;
        padding: 0 var(--space-xs);
    }
    .cook-time {
        margin: 0;
    }
    .card-image-wrapper {
        overflow: hidden;
        margin-top: var(--space-sm);
    }
    .card-image {
        width: 100%;
        height: 20rem;
        object-fit: cover;
        display: block;
        transition: transform 0.2s ease;
    }
    .post-preview-text {
        margin: var(--space-sm) 0 0;
    }
    .tag-wrapper {
        display: flex;
        gap: var(--space-xs);
        margin-top: var(--space-sm);
        flex-wrap: wrap;
    }
    .tag {
        font-size: var(--font-size-sm);
        color: var(--color-text-tertiary);
        font-weight: 500;
        background-color: var(--color-surface);
        padding: var(--space-xs) var(--space-sm);
        border-radius: var(--radius-pill);
        margin: 0;
        white-space: nowrap;
    }
    .full-post-text {
        margin-top: auto;
        padding-top: var(--space-sm);
        color: var(--color-link);
        font-weight: 500;
    }
</style>