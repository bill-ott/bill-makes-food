---
const { href, title, dateRaw, publishDate, cookTime, summary, tags, } = Astro.props;

---
<article class="card-preview">
    <header class="post-title-header">
        <h3 class="post-title">
            <a class="title-link" href={href}>{title}</a>
        </h3>
        <div class="date-wrapper">
            <time class="post-publish-date" datetime={dateRaw}>
                {publishDate}
            </time>
            <p class="date-divider">•</p>
            <p class="cook-time">{cookTime} mins</p>
        </div>
    </header>
    <p class="post-preview-text">{summary}</p>
    {tags.map((tag: string) => <p class="tag">{tag}</p>)}
</article>

<style>
	.card-preview {
		min-height: 20rem;
	}
    .post-title {
        font-size: var(--font-size-h5);
        margin: 0;
    }
    .title-link {
        color: var(--color-text-primary);
        text-decoration: none;
    }
    .date-wrapper {
        color: var(--color-text-tertiary);
        font-size: var(--font-size-sm);
        margin-top: var(--space-xs);
        display: flex;
    }
    .date-divider {
        margin: 0;
        padding: 0 var(--space-xs);
    }
    .cook-time {
        margin: 0;
    }
</style>