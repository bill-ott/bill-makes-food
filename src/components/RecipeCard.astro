---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

type Props = {
    href: string;
	title: string;
	dateRaw: string;
	publishDate: string;
	cookTime: number;
	summary: string;
	tags: string[];
    heroImage?: ImageMetadata;
};

const { href, title, dateRaw, publishDate, cookTime, summary, tags, heroImage } = Astro.props;


---
<article class="card-preview">
    <header class="post-title-header">
        <h3 class="post-title">{title}</h3>
        <div class="date-wrapper">
            <time class="post-publish-date" datetime={dateRaw}>
                {publishDate}
            </time>
            <p class="date-divider">•</p>
            <p class="cook-time">{cookTime} mins</p>
        </div>
    </header>
    <section class="card-content">
        {heroImage && (
            <Image
                src={heroImage}
                alt={title}
                class="card-image" />
        )}
        <p class="post-preview-text">{summary}</p>
        <div class="tag-wrapper">
            {tags.map(tag => <p class="tag">{tag}</p>)}
        </div>
        <a class="full-recipe-link" href={href}>Read the full recipe →</a>
    </section>
</article>

<style>
	.card-preview {
        padding-bottom: var(--space-md);
	}
    .post-title {
        font-size: var(--font-size-h5);
        margin: 0;
    }
    .date-wrapper {
        color: var(--color-text-tertiary);
        font-size: var(--font-size-sm);
        margin-top: var(--space-xs);
        display: flex;
    }
    .date-divider {
        margin: 0;
        padding: 0 var(--space-xs);
    }
    .cook-time {
        margin: 0;
    }
    .card-image {
        width: 100%;
        height: 20rem;
        object-fit: cover;
        margin-top: var(--space-sm);
    }
    .post-preview-text {
        margin: var(--space-sm) 0 0;
    }
    .tag-wrapper {
        display: flex;
        gap: var(--space-xs);
        margin-top: var(--space-sm);
        flex-wrap: wrap;
    }
    .tag {
        font-size: var(--font-size-sm);
        color: var(--color-text-tertiary);
        font-weight: 500;
        background-color: var(--color-surface);
        padding: var(--space-xs) var(--space-sm);
        border-radius: var(--radius-pill);
        margin: 0;
        white-space: nowrap;
    }
    .full-recipe-link {
        display: inline-block;
        color: var(--color-link);
        font-weight: 500;
        margin-top: var(--space-sm);
        text-decoration: none;
    }
</style>