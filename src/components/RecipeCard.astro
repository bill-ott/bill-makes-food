---
const { href, title, dateRaw, publishDate, cookTime, summary, tags, } = Astro.props;

---
<article class="card-preview">
    <header class="post-title-header">
        <h3 class="post-title">
            <a class="title-link" href={href}>{title}</a>
        </h3>
        <div class="date-wrapper">
            <time class="post-publish-date" datetime={dateRaw}>
                {publishDate}
            </time>
            <p>{cookTime} mins</p>
        </div>
    </header>
    <p class="post-preview-text">{summary}</p>
    {tags.map((tag: string) => <p class="tag">{tag}</p>)}
</article>

<style>
	.card-preview {
		min-height: 20rem;
		border: .1rem solid var(--color-border-stronger); /* placeholder for content */
	}
</style>